# chatty-chat local settings.
# Copy to .env and change what you need: Copy-Item .env.example .env
# These are local development values; never reuse them anywhere else.

# Postgres chat-db from chatty-infra (port = CHAT_DB_PORT in chatty-infra/.env)
DATABASE_URL=postgresql+asyncpg://chat_user:chat_pass@127.0.0.1:5433/chat_db

# Redis from chatty-infra
REDIS_URL=redis://127.0.0.1:6379/0

# Shared secret for chatty-core's internal API (X-Service-Token).
# Must be the same value as in chatty-core's .env. Generate one with: openssl rand -hex 32
CORE_SERVICE_TOKEN=change-me

# User tokens are signed by chatty-core; chatty-chat only checks them with the public key.
JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem